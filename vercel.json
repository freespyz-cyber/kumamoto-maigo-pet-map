{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "hero-cover.jpg", "use": "@vercel/static" },
    { "src": "poster.html", "use": "@vercel/static" },
    { "src": "print-mobile.html", "use": "@vercel/static" },
    { "src": "posts.js", "use": "@vercel/node" },
    { "src": "messages.js", "use": "@vercel/node" },
    { "src": "sightings.js", "use": "@vercel/node" },
    { "src": "health.js", "use": "@vercel/node" },
    { "src": "admin.js", "use": "@vercel/node" },
    { "src": "maintenance.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/posts", "dest": "/posts.js" },
    { "src": "/api/messages", "dest": "/messages.js" },
    { "src": "/api/sightings", "dest": "/sightings.js" },
    { "src": "/api/health", "dest": "/health.js" },
    { "src": "/api/admin", "dest": "/admin.js" },
    { "src": "/api/maintenance", "dest": "/maintenance.js" },
    { "src": "/admin.html", "dest": "/admin.html" },
    { "src": "/poster.html", "dest": "/poster.html" },
    { "src": "/p/(\\d+)", "dest": "/poster.html?id=$1" },
    { "src": "/print-mobile.html", "dest": "/print-mobile.html" },
    { "src": "/hero-cover.jpg", "dest": "/hero-cover.jpg" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/maintenance", "schedule": "0 18 * * *" }
  ]
}